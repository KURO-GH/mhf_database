<h1>MHF モンスター肉質データベース</h1>

<% MonstersController::SPECIES_ORDER.each do |species| %>
<% monsters = @monsters_by_species[species] %>

<% next if monsters.blank? %>

  <h2><%= species %></h2>

  <ul>
    <% monsters.each do |monster| %>
      <li>
        <%= link_to monster.name, monster_path(monster) %>
      </li>
    <% end %>
  </ul>
<% end %>
