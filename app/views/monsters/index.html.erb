<h1>MHF モンスター肉質データベース</h1>

<% @monsters.each do |monster| %>
  <h2><%= monster.name %></h2>

  <% monster.monster_variants.each do |variant| %>
    <h3><%= variant.name %></h3>

    <table border="1">
      <thead>
        <tr>
          <th>部位</th>
          <th>切断</th>
          <th>打撃</th>
          <th>弾</th>
          <th>火</th>
          <th>水</th>
          <th>雷</th>
          <th>龍</th>
          <th>氷</th>
          <th>気絶</th>
        </tr>
      </thead>

      <tbody>
        <% variant.hitzones.each do |hitzone| %>
          <tr>
            <td><%= hitzone.part_name %></td>
            <td><%= hitzone.slash %></td>
            <td><%= hitzone.blunt %></td>
            <td><%= hitzone.shot %></td>
            <td><%= hitzone.fire %></td>
            <td><%= hitzone.water %></td>
            <td><%= hitzone.thunder %></td>
            <td><%= hitzone.dragon %></td>
            <td><%= hitzone.ice %></td>
            <td><%= hitzone.stun %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
