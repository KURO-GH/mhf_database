<h1>MHF モンスター肉質データベース</h1>

<h2><%= @monster.name %></h2>

<p>
  <% @monster.monster_variants.each_with_index do |variant, index| %>
    <% if index > 0 %>
      |
    <% end %>

    <%= link_to variant.name, monster_path(@monster, variant: variant.name) %>
  <% end %>
</p>

<h3><%= @variant.name %></h3>

<h4>肉質</h4>

<table border="1">
  <thead>
    <tr>
      <th>部位</th>
      <th>切断</th>
      <th>打撃</th>
      <th>弾</th>
      <th>火</th>
      <th>水</th>
      <th>雷</th>
      <th>龍</th>
      <th>氷</th>
      <th>気絶</th>
    </tr>
  </thead>

  <tbody>
    <% @hitzones.each do |hitzone| %>
      <tr>
        <td><%= hitzone.part_name %></td>
        <td><%= hitzone.slash %></td>
        <td><%= hitzone.blunt %></td>
        <td><%= hitzone.shot %></td>
        <td><%= hitzone.fire %></td>
        <td><%= hitzone.water %></td>
        <td><%= hitzone.thunder %></td>
        <td><%= hitzone.dragon %></td>
        <td><%= hitzone.ice %></td>
        <td><%= hitzone.stun %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h4>状態異常</h4>

<table border="1">
  <thead>
    <tr>
      <th>状態異常</th>
      <th>初期耐性</th>
      <th>耐性上昇</th>
      <th>上昇回数</th>
      <th>耐性減少</th>
      <th>減少間隔</th>
      <th>持続時間</th>
      <th>蓄積率</th>
      <th>ダメージ</th>
      <th>無効</th>
    </tr>
  </thead>

  <tbody>
    <% @status_resistances.each do |status| %>
      <tr>
        <td><%= status.status %></td>
        <td><%= status.initial_resistance %></td>
        <td><%= status.resistance_increase %></td>
        <td><%= status.increase_count %></td>
        <td><%= status.resistance_decrease %></td>
        <td><%= status.decrease_interval %></td>
        <td><%= status.duration %></td>
        <td><%= status.capture_rate %></td>
        <td><%= status.damage %></td>
        <td><%= status.immune ? "○" : "－" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>
  <%= link_to "モンスター一覧に戻る", monsters_path %>
</p>
